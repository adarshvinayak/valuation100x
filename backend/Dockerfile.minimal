# Ultra-Minimal Railway Dockerfile - Absolute Minimum Context
# Copies only essential Python files to minimize Docker context

FROM python:3.11-slim

# Railway optimization environment
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH="/app" \
    PORT=8000

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create app user
RUN useradd --create-home --shell /bin/bash --uid 1000 app

# Set work directory
WORKDIR /app

# Copy ONLY the requirements file first
COPY requirements.railway.fast.txt .

# Install dependencies
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --timeout=120 \
    -r requirements.railway.fast.txt

# Create directories
RUN mkdir -p data/outputs data/cache data/index logs models/embeddings && \
    chown -R app:app /app

# Copy ONLY essential Python files (minimize context)
COPY --chown=app:app api_server.py ./
COPY --chown=app:app config.py ./
COPY --chown=app:app workflow.py ./
COPY --chown=app:app runtime_installer.py ./
COPY --chown=app:app run_enhanced_analysis.py ./
COPY --chown=app:app run_damodaran_integrated.py ./

# Copy essential directories (only .py files)
COPY --chown=app:app agents/*.py ./agents/
COPY --chown=app:app tools/*.py ./tools/
COPY --chown=app:app synthesis/*.py ./synthesis/
COPY --chown=app:app database/*.py ./database/
COPY --chown=app:app ingestion/*.py ./ingestion/
COPY --chown=app:app utils/*.py ./utils/

# Copy essential config files
COPY --chown=app:app configs/ ./configs/

# Switch to non-root user
USER app

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Run the application
CMD ["python", "api_server.py"]
