# Ultra-Fast Railway Dockerfile - Bypass Build Timeouts
# Strategy: Install only essential deps, lazy-load heavy ML packages at runtime

FROM python:3.11-slim

# Railway optimization environment
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH="/app" \
    PORT=8000

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create app user
RUN useradd --create-home --shell /bin/bash --uid 1000 app

# Set work directory
WORKDIR /app

# Copy fast requirements first (for better caching)
COPY requirements.railway.fast.txt .

# Install only fast dependencies (should complete in <5 minutes)
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --timeout=120 \
    -r requirements.railway.fast.txt

# Create necessary directories
RUN mkdir -p data/outputs data/cache data/index logs models/embeddings && \
    chown -R app:app /app

# Copy application code
COPY --chown=app:app . .

# Switch to non-root user
USER app

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Run the application
CMD ["python", "api_server.py"]
